# ===== 阿里云百炼（Model Studio / DashScope）配置 =====
# 复制本文件为 .env，仅配置非敏感选项。不要在文件中保存 API Key。
# 每次运行启动脚本时会隐藏输入 API Key，只在服务进程内存中使用。

# 使用的模型须在 bailian_models.py 的百炼清单中
MODEL=qwen3.8-flash
# 百炼控制台中的已启用模型均开启“免费额度用完即停”后，再将以下配置设为 1。
OSINT_BAILIAN_FREE_ONLY_CONFIRMED=0
# 可用逗号分隔的模型 ID 暂停个别模型。只能收窄仓库中的额度名单。
OSINT_DISABLED_MODELS=

# 业务空间 ID（可选）。仅当你要使用百炼 Connector 统一 MCP 入口时才需要，形如 llm-xxxxxxxx
WORKSPACE_ID=

# 可选：填写已建立索引且允许送交模型的本地资料目录，以及 sag.sqlite 所在目录。
OSINT_SAG_SCOPE=
SAG_DATA_DIR=
# 旅游后端。合并乙的页面后默认使用 static/travel/data/pois.json。
TRAVEL_MCP_TIMEOUT=35
TRAVEL_KB_BASE_URL=
TRAVEL_KB_TOKEN=
VARIFLIGHT_API_KEY=
# 自定义 Node 或 Tesseract 可执行文件时设置 TRAVEL_NODE、TRAVEL_OCR_BINARY。
# 企业 CA 使用容器中可读的 NODE_EXTRA_CA_CERTS 路径。
